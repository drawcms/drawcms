{
  "name": "drawcms",
  "version": "0.14.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcms/drawcms.git"
  },
  "homepage": "https://github.com/drawcms/drawcms#readme",
  "bugs": {
    "url": "https://github.com/drawcms/drawcms/issues"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "next build --webpack",
    "start": "next start -p 3002",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench src/editor/perf",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run sites:ci",
    "docs:dev": "npm --prefix site run dev",
    "blog:dev": "npm --prefix site-blog run dev -- --port 4322",
    "docs:build": "npm --prefix site run build",
    "blog:build": "npm --prefix site-blog run build",
    "docs:deploy": "npm run build --prefix site && wrangler deploy --config site/wrangler.jsonc",
    "blog:deploy": "npm run build --prefix site-blog && wrangler deploy --config site-blog/wrangler.jsonc",
    "sites:ci": "npm ci --prefix site && npm test --prefix site && npm run build --prefix site && npm ci --prefix site-blog && npm test --prefix site-blog && npm run build --prefix site-blog",
    "build:cloudflare": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare": "opennextjs-cloudflare preview -- --port 3000",
    "deploy:cloudflare": "opennextjs-cloudflare deploy"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "postcss": {
        ".": "8.5.25",
        "nanoid": "3.3.18"
      },
      "sharp": "0.35.3"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "gif.js": "^0.2.0",
    "gsap": "3.14.2",
    "html-to-image": "1.11.11",
    "lucide-react": "1.0.1",
    "mp4-muxer": "^4.2.1",
    "nanoid": "^5.1.7",
    "next": "16.2.12",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.127.1"
  }
}
