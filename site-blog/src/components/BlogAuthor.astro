---
import type { StarlightBlogAuthor } from "starlight-blog/schema";

interface Props {
  author: StarlightBlogAuthor;
  compact?: boolean;
}

const { author, compact = false } = Astro.props;
const Element = author.url ? "a" : "div";
const initials = author.name
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<Element
  class:list={["dm-blog-author", { "dm-blog-author--compact": compact }]}
  href={author.url}
  aria-label={author.url ? `Open ${author.name}'s GitHub profile` : undefined}
>
  <span class="dm-blog-author-avatar" aria-hidden="true">
    <span>{initials}</span>
    {
      author.picture && (
        <img src={author.picture} alt="" loading={compact ? "lazy" : "eager"} decoding="async" />
      )
    }
  </span>
  <span class="dm-blog-author-details">
    <strong>{author.name}</strong>
    {author.title && <small>{author.title}</small>}
  </span>
</Element>

<style>
  .dm-blog-author {
    align-items: center;
    color: inherit;
    display: inline-flex;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .dm-blog-author-avatar {
    align-items: center;
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 28%, transparent);
    border-radius: 999px;
    color: var(--sl-color-text-accent);
    display: flex;
    flex: 0 0 auto;
    font-size: var(--sl-text-2xs);
    font-weight: 700;
    height: 2.5rem;
    justify-content: center;
    overflow: hidden;
    position: relative;
    width: 2.5rem;
  }

  .dm-blog-author-avatar img {
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  .dm-blog-author-details,
  .dm-blog-author-details strong,
  .dm-blog-author-details small {
    display: block;
  }

  .dm-blog-author-details strong {
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.3;
  }

  .dm-blog-author-details small {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-2xs);
    line-height: 1.35;
    margin-top: 0.1rem;
  }

  .dm-blog-author[href] .dm-blog-author-details strong {
    transition: color 100ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .dm-blog-author[href]:hover .dm-blog-author-details strong,
  .dm-blog-author[href]:focus-visible .dm-blog-author-details strong {
    color: var(--sl-color-text-accent);
  }

  .dm-blog-author--compact {
    gap: 0.625rem;
    margin-top: 1rem;
  }

  .dm-blog-author--compact .dm-blog-author-avatar {
    height: 2rem;
    width: 2rem;
  }

  .dm-blog-author--compact .dm-blog-author-details small {
    display: none;
  }
</style>
