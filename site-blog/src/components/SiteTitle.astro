---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="dm-site-title">
  <span class="dm-brand-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path
        d="M 6 4 L 14 4 C 18.418 4 22 7.582 22 12 C 22 16.418 18.418 20 14 20 L 6 20 L 6 4 Z"
        opacity="0.45"
      ></path>
      <path d="M 6 4 L 10 4 C 14.418 4 18 7.582 18 12 C 18 16.418 14.418 20 10 20 L 6 20 L 6 4 Z"></path>
    </svg>
  </span>
  <span class="dm-wordmark" translate="no">
    <span>Draw</span><strong>CMS</strong>
  </span>
  <span class="dm-section-name">Blog</span>
</a>

<style>
  .dm-site-title {
    align-items: center;
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    display: inline-flex;
    gap: 0.625rem;
    min-height: 2.5rem;
    min-width: 0;
    text-decoration: none;
  }

  .dm-brand-mark {
    align-items: center;
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-text-accent) 22%, transparent);
    border-radius: 0.25rem;
    color: var(--sl-color-text-accent);
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .dm-brand-mark svg {
    fill: currentColor;
    height: 1.5rem;
    width: 1.5rem;
  }

  .dm-wordmark {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .dm-wordmark strong {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .dm-section-name {
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    padding-inline-start: 0.625rem;
    white-space: nowrap;
  }

  @media (max-width: 24rem) {
    .dm-section-name {
      display: none;
    }
  }
</style>
