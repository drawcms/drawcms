export type DmIconName = keyof typeof icons;

interface Props {
  name: DmIconName;
  size?: string;
  stroke?: string;
  class?: string;
  label?: string;
}

const { name, size = "1.125rem", stroke = "1.75", class: className, label } = Astro.props;
const a11y = label ? { "aria-label": label, role: "img" } : { "aria-hidden": "true" };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
  set:html={icons[name]}
/>

<style>
  svg {
    flex-shrink: 0;
  }
</style>
