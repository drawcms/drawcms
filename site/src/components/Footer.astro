---
import DmIcon from "./DmIcon.astro";
import Pagination from "virtual:starlight/components/Pagination";

const GITHUB_URL = "https://github.com/drawcms/drawcms";
---

<div class="dm-footer-flow">
  <Pagination />
</div>

<style>
  .dm-footer-flow {
    display: flex;
    flex-direction: column;
  }

</style>

<footer class="dm-footer">
  <div class="dm-footer-social">
    <a href={GITHUB_URL} aria-label="GitHub">
      <DmIcon name="github" size="1.25rem" />
    </a>
  </div>
  <p class="dm-footer-note">
    Built with
    <a href="https://starlight.astro.build" rel="noopener">Starlight</a>
  </p>
</footer>

<style>
  .dm-footer {
    align-items: center;
    border-top: 1px solid var(--sl-color-hairline);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.25rem;
  }

  .dm-footer-social {
    display: flex;
    gap: 0.875rem;
  }

  .dm-footer-social a {
    color: var(--sl-color-gray-3);
    transition: color 100ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .dm-footer-social a:hover {
    color: var(--sl-color-white);
  }

  .dm-footer-note {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    margin: 0;
  }

  .dm-footer-note a {
    color: var(--sl-color-gray-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
