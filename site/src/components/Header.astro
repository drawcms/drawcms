---
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import { getActiveDocsSection } from "../../plugins/header-navigation.mjs";

interface NavLink {
  label: string;
  href: string;
  section?: string;
}

const NAV_LINKS: NavLink[] = [
  { label: "Guide", href: "/docs", section: "guide" },
  { label: "Cloud", href: "/docs/cloud", section: "cloud" },
  { label: "Self-Hosting", href: "/docs/self-hosting", section: "self-hosting" },
  { label: "Public API", href: "/docs/plugin-api", section: "public-api" },
  { label: "Contributing", href: "/docs/contributing", section: "contributing" },
];

const activeSection = getActiveDocsSection(Astro.url.pathname, import.meta.env.BASE_URL);
---

<header class="dm-header">
  <nav class="dm-header-nav" aria-label="Sections">
    {
      NAV_LINKS.map((link) => {
        const isActive = link.section === activeSection;
        return (
          <a
            href={link.href}
            class:list={["dm-header-tab", { "dm-header-tab-active": isActive }]}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
  <div class="dm-header-right">
    <div class="dm-header-social">
      <SocialIcons />
    </div>
  </div>
</header>

<style>
  .dm-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    height: 100%;
    padding-inline: 0;
    width: 100%;
  }

  .dm-header-nav {
    display: none;
    gap: 0.25rem;
    height: 100%;
  }

  .dm-header-tab {
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--sl-color-gray-3);
    display: inline-flex;
    font-size: 0.875rem;
    font-weight: 500;
    height: 100%;
    padding-inline: 0.625rem;
    position: relative;
    text-decoration: none;
    transition: color 100ms cubic-bezier(0.23, 1, 0.32, 1);
    white-space: nowrap;
  }

  .dm-header-tab:hover {
    color: var(--sl-color-white);
  }

  .dm-header-tab-active,
  .dm-header-tab-active:hover {
    color: var(--sl-color-white);
  }

  .dm-header-tab-active::after {
    background: var(--sl-color-text-accent);
    border-radius: 1px;
    bottom: -1px;
    content: "";
    height: 2px;
    left: 0.625rem;
    position: absolute;
    right: 0.625rem;
  }

  .dm-header-right {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    margin-inline-start: auto;
    min-width: 0;
  }

  .dm-header-social {
    align-items: center;
    display: flex;
  }

  .dm-header-social :global(a) {
    color: var(--sl-color-gray-3);
  }

  .dm-header-social :global(a:hover) {
    color: var(--sl-color-white);
  }

  @media (min-width: 64rem) {
    .dm-header-nav {
      display: flex;
    }
  }

  @media (max-width: 63.99rem) {
    .dm-header-social {
      display: none;
    }
  }
</style>
