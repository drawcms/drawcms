---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="dm-site-title">
  <span class="dm-brand-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path
        d="M 6 4 L 14 4 C 18.418 4 22 7.582 22 12 C 22 16.418 18.418 20 14 20 L 6 20 L 6 4 Z"
        opacity="0.45"
      ></path>
      <path d="M 6 4 L 10 4 C 14.418 4 18 7.582 18 12 C 18 16.418 14.418 20 10 20 L 6 20 L 6 4 Z"></path>
    </svg>
  </span>
  <span class="dm-wordmark" translate="no">
    <span>Draw</span><strong>CMS</strong>
  </span>
</a>

<style>
  .dm-site-title {
    align-items: center;
    border-radius: 0.25rem;
    color: var(--sl-color-white);
    display: inline-flex;
    gap: 0.5rem;
    min-height: 2.5rem;
    min-width: 0;
    padding-inline-end: 0.25rem;
    text-decoration: none;
  }

  .dm-brand-mark {
    align-items: center;
    color: var(--sl-color-text-accent);
    display: inline-flex;
    justify-content: center;
  }

  .dm-brand-mark svg {
    fill: currentColor;
    height: 1.375rem;
    width: 1.375rem;
  }

  .dm-wordmark {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .dm-wordmark strong {
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }
</style>
