// Docs site: static assets on Cloudflare Workers (assets-only worker, no
// script). Served at drawcms.com/docs via a path route — the app worker owns
// drawcms.com/*, so it must be attached with a route pattern (not a custom
// domain, which would take precedence over this route). Deployed from
// .github/workflows/docs-deploy.yml or via `npm run docs:deploy`.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "drawcms-docs",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "drawcms.com/docs*",
      "zone_name": "drawcms.com",
    },
  ],
}
